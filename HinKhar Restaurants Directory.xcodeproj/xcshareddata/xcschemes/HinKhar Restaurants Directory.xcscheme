      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Script"
               scriptText = "# Type a script or drag a script file from your workspace to insert its path.&#10;#!/bin/bash&#10;&#10;set -e&#10;&#10;echo &quot;========================================&quot;&#10;echo &quot;Firebase dSYM Archive Workaround&quot;&#10;echo &quot;========================================&quot;&#10;&#10;# Xcode archive location&#10;ARCHIVE_PATH=&quot;${ARCHIVE_PATH}&quot;&#10;&#10;if [ -z &quot;$ARCHIVE_PATH&quot; ]; then&#10;    echo &quot;ERROR: ARCHIVE_PATH is empty.&quot;&#10;    exit 1&#10;fi&#10;&#10;DSYM_DIR=&quot;${ARCHIVE_PATH}/dSYMs&quot;&#10;&#10;echo &quot;Archive:&quot;&#10;echo &quot;$ARCHIVE_PATH&quot;&#10;&#10;echo &quot;&quot;&#10;echo &quot;dSYM directory:&quot;&#10;echo &quot;$DSYM_DIR&quot;&#10;&#10;mkdir -p &quot;$DSYM_DIR&quot;&#10;&#10;# Find the DerivedData directory used by this project&#10;DERIVED_DATA=&quot;${BUILD_ROOT%/Build/*}&quot;&#10;&#10;echo &quot;&quot;&#10;echo &quot;DerivedData:&quot;&#10;echo &quot;$DERIVED_DATA&quot;&#10;&#10;# Firebase SPM artifacts&#10;SPM_ARTIFACTS=&quot;$DERIVED_DATA/SourcePackages/artifacts&quot;&#10;&#10;echo &quot;&quot;&#10;echo &quot;Searching Firebase SPM artifacts:&quot;&#10;echo &quot;$SPM_ARTIFACTS&quot;&#10;&#10;if [ ! -d &quot;$SPM_ARTIFACTS&quot; ]; then&#10;    echo &quot;WARNING: SPM artifacts directory not found.&quot;&#10;    exit 0&#10;fi&#10;&#10;# Frameworks reported by App Store Connect&#10;FRAMEWORKS=(&#10;    &quot;FirebaseAnalytics&quot;&#10;    &quot;GoogleAdsOnDeviceConversion&quot;&#10;    &quot;GoogleAppMeasurement&quot;&#10;    &quot;GoogleAppMeasurementIdentitySupport&quot;&#10;)&#10;&#10;for FRAMEWORK in &quot;${FRAMEWORKS[@]}&quot;; do&#10;&#10;    echo &quot;&quot;&#10;    echo &quot;----------------------------------------&quot;&#10;    echo &quot;Searching for ${FRAMEWORK}.framework.dSYM&quot;&#10;    echo &quot;----------------------------------------&quot;&#10;&#10;    FOUND=0&#10;&#10;    while IFS= read -r DSYM; do&#10;&#10;        if [ -d &quot;$DSYM&quot; ]; then&#10;&#10;            echo &quot;Found:&quot;&#10;            echo &quot;$DSYM&quot;&#10;&#10;            cp -R &quot;$DSYM&quot; &quot;$DSYM_DIR/&quot;&#10;&#10;            FOUND=1&#10;&#10;            echo &quot;Copied to:&quot;&#10;            echo &quot;$DSYM_DIR/$(basename &quot;$DSYM&quot;)&quot;&#10;&#10;        fi&#10;&#10;    done &lt; &lt;(&#10;        find &quot;$SPM_ARTIFACTS&quot; \&#10;            -type d \&#10;            -name &quot;${FRAMEWORK}.framework.dSYM&quot; \&#10;            2&gt;/dev/null&#10;    )&#10;&#10;    if [ &quot;$FOUND&quot; -eq 0 ]; then&#10;        echo &quot;WARNING: No dSYM found for ${FRAMEWORK}&quot;&#10;    fi&#10;&#10;done&#10;&#10;echo &quot;&quot;&#10;echo &quot;========================================&quot;&#10;echo &quot;Final dSYMs&quot;&#10;echo &quot;========================================&quot;&#10;&#10;find &quot;$DSYM_DIR&quot; \&#10;    -maxdepth 1 \&#10;    -type d \&#10;    -name &quot;*.dSYM&quot; \&#10;    -print&#10;&#10;echo &quot;&quot;&#10;echo &quot;Firebase dSYM workaround completed.&quot;&#10;">
               <EnvironmentBuildable>
